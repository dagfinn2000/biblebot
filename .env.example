# Copy this file to .env and fill in the two keys.

# Discord bot token (Discord Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Anthropic API key (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Optional settings
# Claude model that picks the verse. claude-haiku-5-5 is much cheaper and usually good enough.
CLAUDE_MODEL=claude-opus-5-5
# Default translation: web, kjv, asv, bbe or ylt
DEFAULT_TRANSLATION=web
# How many recent messages /verse reads when no topic is given
CONTEXT_MESSAGES=10
# Seconds each person must wait between verses
COOLDOWN_SECONDS=15
# Your server's ID, so commands show up instantly while testing (leave empty for all servers)
GUILD_ID=
